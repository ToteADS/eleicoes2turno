# Server
PORT=8080
STATIC_DIR=../web/dist
ALLOWED_ORIGIN=https://eleicoes2turno.tapp.solutions
# Set true only when Cloudflare proxies the domain (uses CF-Connecting-IP for rate limiting)
TRUST_CLOUDFLARE=false

# TSE polling (public data, no credentials)
TSE_BASE_URL=https://resultados.tse.jus.br/oficial
FAST_INTERVAL=30s
MUN_CONCURRENCY=4

# Ads (all public values). Leave ADSENSE_CLIENT empty to show the house banner only.
ADSENSE_CLIENT=
ADSENSE_SLOT_RESULTS=
ADSENSE_SLOT_MOBILE=
HOUSE_AD_IMAGE=/ads/tapp-banner.svg
HOUSE_AD_LINK=https://tapp.solutions
HOUSE_AD_ALT=Tapp Solutions
